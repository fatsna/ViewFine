<Application x:Class="ViewFine.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ViewFine.Views"
             xmlns:vm="clr-namespace:ViewFine.ViewModels">
    <Application.Resources>


        <!-- Light palette -->
        <SolidColorBrush x:Key="PhoneBg"     Color="#F5F7FB"/>
        <SolidColorBrush x:Key="PhonePanel"  Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PhoneAccent" Color="#3D6BFF"/>
        <SolidColorBrush x:Key="PhoneText"   Color="#1C2430"/>
        <SolidColorBrush x:Key="PhoneSub"    Color="#6A7A95"/>

        <!-- 카드형 버튼 (라이트) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PhonePanel}"/>
            <Setter Property="Foreground" Value="{StaticResource PhoneText}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderBrush" Value="#E6EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="#3A3A3A" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F4FF"/>
                                <Setter Property="BorderBrush"  Value="#D5DFFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E6EEFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <!-- Tag에 넣은 문자열을 워터마크로 표시 -->
                            <TextBlock x:Name="Watermark"
                         Text="{TemplateBinding Tag}"
                         Margin="6,3,0,0"
                         Foreground="#80FFFFFF"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 내용이 비어 있고 포커스 없을 때만 워터마크 보이기 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light Navy Theme -->
        <SolidColorBrush x:Key="PrimaryNavy" Color="#FF1E2A44"/>
        <SolidColorBrush x:Key="PrimaryNavyLight" Color="#FF2B3B63"/>
        <SolidColorBrush x:Key="OnNavy" Color="#FFFFFFFF"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource PrimaryNavy}"/>
            <Setter Property="Foreground" Value="{StaticResource OnNavy}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryNavyLight}"/>
            <Setter Property="Foreground" Value="{StaticResource OnNavy}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- VM -> View 매핑 -->
        <DataTemplate DataType="{x:Type vm:ListViewModel}">
            <v:ListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrendsViewModel}">
            <v:TrendsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalculatorViewModel}">
            <v:CalculatorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <v:UpdatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaqViewModel}">
            <v:FaqView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <v:HomeView/>
        </DataTemplate>

    </Application.Resources>
</Application>
