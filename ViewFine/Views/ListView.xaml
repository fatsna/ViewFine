<UserControl x:Class="ViewFine.Views.ListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="280" Margin="0,0,8,0"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Tag="검색(번호/라벨/법조)"/>
            <Button Content="새로고침" Command="{Binding LoadAsyncCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
              ItemsSource="{Binding View}"
              AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="구분"  Binding="{Binding category}" Width="80"/>
                <DataGridTextColumn Header="번호"  Binding="{Binding item_no}" Width="90"/>
                <DataGridTextColumn Header="라벨"  Binding="{Binding label}" Width="*"/>
                <DataGridTextColumn Header="법조"  Binding="{Binding law}"   Width="220"/>
                <DataGridTextColumn Header="벌점"  Binding="{Binding points}" Width="80"/>
                <DataGridTextColumn Header="시행"  Binding="{Binding revised_date}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
