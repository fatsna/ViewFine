<!-- ListView.xaml -->
<UserControl x:Class="ViewFine.Views.ListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ViewFine.ViewModels">
    <Grid>
        <ListView ItemsSource="{Binding Items}" BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <!-- 카드 스타일(테두리/여백) -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,6,0,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListView.ItemContainerStyle>

            <!-- 행: Expander 카드 -->
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PenaltyItem}">
                    <Border Padding="12" CornerRadius="12"
                            Background="White" BorderBrush="#E6EAF2" BorderThickness="1">
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <!-- 닫힌 상태에 보일 헤더: 번호 · 내용 · 조치 -->
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding ItemNo}"
                                               FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               TextWrapping="Wrap" Foreground="#334155"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ActionText}"
                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{StaticResource PhoneAccent}"/>
                                </Grid>
                            </Expander.Header>

                            <!-- 펼친 내용: 법 조항 / 시행일자 -->
                            <StackPanel Margin="0,8,0,0">
                                <Separator/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="법 조항: " Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Law}" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="시행일자: " Foreground="#64748B"/>
                                    <TextBlock Text="{Binding RevisedDateParsed, StringFormat=\{0:yyyy-MM-dd\}}"
                                               Foreground="#334155"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
