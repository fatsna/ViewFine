<Window x:Class="ViewFine.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViewFine - 별표28" Height="720" Width="1180">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Nav -->
        <StackPanel Orientation="Horizontal">
            <Button Content="목록"     Command="{Binding NavigateListCommand}"/>
            <Button Content="지역비교" Command="{Binding NavigateTrendsCommand}"/>
            <Button Content="계산기"   Command="{Binding NavigateCalcCommand}"/>
            <Button Content="개정알림" Command="{Binding NavigateUpdatesCommand}"/>
            <Button Content="상황카드" Command="{Binding NavigateFaqCommand}"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
